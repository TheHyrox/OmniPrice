# ==============================================================================
# OmniPrice - Configuration d'environnement (Exemple)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Serveur Web
# ------------------------------------------------------------------------------
# Port d'écoute du serveur OmniPrice
PORT=3005

# Définir sur "true" uniquement si vous souhaitez autoriser le scraping d'adresses
# sur votre réseau local / homelab (la protection SSRF bloque les IP privées par défaut)
ALLOW_PRIVATE_NETWORK=false

# ------------------------------------------------------------------------------
# 2. Base de données MongoDB
# ------------------------------------------------------------------------------
# Mode local autonome (sans Docker) :
MONGO_URI=mongodb://localhost:27017/omniprice

# Mode Docker Compose (nom du service 'omniprice-db') :
# MONGO_URI=mongodb://omniprice-db:27017/omniprice

# Instance MongoDB distante ou avec authentification sur votre Homelab :
# MONGO_URI=mongodb://utilisateur:motdepasse@192.168.1.100:27017/omniprice?authSource=admin

# ------------------------------------------------------------------------------
# 3. Performances & Puppeteer (Optimisation pour 1 Go de RAM)
# ------------------------------------------------------------------------------
# Nombre maximum d'onglets Chromium ouverts en parallèle (1 recommandé sur VPS 1 Go)
PUPPETEER_CONCURRENCY=1

# Chemin de l'exécutable Chromium système (optionnel, ex: /usr/bin/chromium sous Linux/Docker)
# Laisser vide pour utiliser le Chromium téléchargé par Puppeteer
PUPPETEER_EXECUTABLE_PATH=

# ------------------------------------------------------------------------------
# 4. Notifications : Discord Webhook (Optionnel)
# ------------------------------------------------------------------------------
# URL du webhook Discord par défaut pour les alertes de baisse de prix
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ------------------------------------------------------------------------------
# 5. Notifications : Web Push / Navigateur (Optionnel)
# ------------------------------------------------------------------------------
# Clés VAPID pour les notifications Push du navigateur et PWA.
# Si laissées vides, OmniPrice génère automatiquement des clés persistantes dans MongoDB.
# Génération manuelle possible avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@homelab.local
