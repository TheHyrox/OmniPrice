# OmniPrice Environment Configuration
PORT=3005

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/omniprice

# Discord Webhook for notifications (Optional - can also be configured in Settings UI)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# VAPID Keys for Web Push Notifications (Optional - auto-generated if omitted)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
