# ==============================================================================
# OmniPrice - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# HTTP port for the web application
PORT=3005

# Set to "true" only if you want to allow scraping services on your private LAN / localhost
# (SSRF protection blocks internal/private IPs by default)
ALLOW_PRIVATE_NETWORK=false

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB)
# ------------------------------------------------------------------------------
# For standalone local run:
MONGO_URI=mongodb://localhost:27017/omniprice

# For Docker Compose setup (service name 'omniprice-db'):
# MONGO_URI=mongodb://omniprice-db:27017/omniprice

# For authenticated remote/homelab MongoDB instance:
# MONGO_URI=mongodb://username:password@192.168.1.100:27017/omniprice?authSource=admin

# ------------------------------------------------------------------------------
# 3. Scraping & Resource Management (1GB RAM Optimization)
# ------------------------------------------------------------------------------
# Maximum concurrent Puppeteer browser tabs (1 tab is recommended for 1GB RAM VPS/homelab)
PUPPETEER_CONCURRENCY=1

# Custom path to system Chromium executable (e.g. in Docker or custom Linux install)
# Leave blank to use Puppeteer's default bundled browser
PUPPETEER_EXECUTABLE_PATH=

# ------------------------------------------------------------------------------
# 4. Notifications: Discord Webhook (Optional)
# ------------------------------------------------------------------------------
# Default Discord webhook for price drop alerts (can also be configured in Settings UI)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ------------------------------------------------------------------------------
# 5. Notifications: Web Push / PWA (Optional)
# ------------------------------------------------------------------------------
# VAPID keys for browser push notifications. If left blank, OmniPrice will automatically
# generate persistent keys in MongoDB on first startup.
# To generate manually: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
